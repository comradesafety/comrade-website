# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# Flask environment: "development" or "production"
FLASK_ENV=development

# Set to "1" only for local development. Must be "0" in production.
FLASK_DEBUG=0

# Long, random, secret string used to sign sessions and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key

# Host and port used by run.py during local development.
HOST=127.0.0.1
PORT=5000

# Google Apps Script Web App URL the recruitment form's backend forwards
# validated submissions to (see google-apps-script/Code.gs for the script
# to deploy, and its own comments for how to get this URL). Leave unset
# and the form still renders normally; submissions just fail with a
# clear "not configured" log line instead of silently going nowhere.
GOOGLE_APPS_SCRIPT_URL=

# Minimum seconds between two submissions from the same IP. Optional;
# defaults to 30 if unset.
RECRUITMENT_SUBMIT_COOLDOWN_SECONDS=30
